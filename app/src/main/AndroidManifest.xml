<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 截屏权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+ 悬浮窗前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 语音识别权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="扑克AI助手"
        android:supportsRtl="true"
        android:theme="@style/Theme.MjScreenshot"
        android:usesCleartextTraffic="true">

        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Floating overlay window for poker game assistance" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="扑克AI助手"
            android:theme="@style/Theme.MjScreenshot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 截屏前台服务 -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- HTTP服务器服务 -->
        <service
            android:name=".HttpServerService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- 悬浮窗服务 -->
        <service
            android:name=".FloatingService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- V1.9: 无障碍截图服务（替代MediaProjection，不触发游戏黑屏检测） -->
        <service
            android:name=".PokerAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
