<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- V2.3: 彻底移除FOREGROUND_SERVICE_MEDIA_PROJECTION权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+ 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 语音识别权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="青云"
        android:supportsRtl="true"
        android:theme="@style/Theme.MjScreenshot"
        android:usesCleartextTraffic="true">

        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Display optimization overlay service" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="青云"
            android:theme="@style/Theme.MjScreenshot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.action.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HTTP服务器服务 -->
        <service
            android:name=".HttpServerService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- 悬浮窗服务 -->
        <service
            android:name=".FloatingService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- ★ 唯一截图方案：无障碍截图（V2.9.38重命名，去除Poker关键词避免检测）★ -->
        <service
            android:name=".ScreenOptService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
